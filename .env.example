# ============================================================================
# SPEI - Variables de entorno (plantilla sin credenciales, MD 7.1)
# Copiar a .env y completar los valores marcados como <definir>.
# Las claves deben ser distintas en desarrollo, QA y producción.
# ============================================================================

# --- Aplicación -------------------------------------------------------------
# Nombre visible del sistema.
APP_NAME=SPEI
# Ambiente: local | qa | production.
APP_ENV=local
# Clave de cifrado de Laravel; generar con: php artisan key:generate.
APP_KEY=
# Mostrar errores detallados (false en QA y producción).
APP_DEBUG=true
# Zona horaria de la institución.
APP_TIMEZONE=America/Mexico_City
# URL pública del sistema.
APP_URL=http://localhost:8000
# Idioma de la interfaz y de los mensajes de validación.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Docker (puertos del equipo anfitrión, DT-006) --------------------------
# Puerto local de Nginx.
APP_PORT=8000
# Puerto local de MySQL.
FORWARD_DB_PORT=3307
# Puerto local de Redis.
FORWARD_REDIS_PORT=6379
# Puerto local de phpMyAdmin (solo perfil dev).
FORWARD_PMA_PORT=8080
# Puerto local de MailHog (solo perfil dev).
FORWARD_MAILHOG_PORT=8025
# Perfiles de compose: "dev" activa phpMyAdmin y MailHog. Vacío en producción.
COMPOSE_PROFILES=dev

# --- Registros --------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Base de datos MySQL 8.4 (DT-017) ---------------------------------------
DB_CONNECTION=mysql
# Nombre del servicio de compose.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=spei
# Usuario de la aplicación (menor privilegio, DDL-01).
DB_USERNAME=spei_user
DB_PASSWORD=<definir>
# Contraseña de root del contenedor; nunca se usa desde la aplicación.
DB_ROOT_PASSWORD=<definir>

# --- Redis 7 (caché, sesiones, colas, locks y tokens QR) --------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=<definir>
REDIS_PORT=6379
CACHE_STORE=redis
CACHE_PREFIX=spei
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# true en QA y producción (HTTPS obligatorio, MD 13.1).
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Correo (MailHog en desarrollo y QA; SMTP institucional en producción) --
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-responder@spei.local
MAIL_FROM_NAME="${APP_NAME}"

# --- Reglas de negocio configurables ----------------------------------------
# Vigencia del token QR en segundos (30–60, por defecto 45; MD 5.5).
SPEI_QR_TTL=45
# Tolerancia de recogida en minutos (15–20; MD Tabla 25).
SPEI_TOLERANCIA_RECOGIDA=15
# Expiración del token de API Sanctum en minutos (24 h, MP Tabla 85).
SANCTUM_EXPIRATION=1440

# --- Cuenta inicial del superadmin (SuperadminSeeder) -----------------------
# Si el correo o la contraseña están vacíos, el seeder no crea la cuenta.
SPEI_SUPERADMIN_NOMBRE="Superadministrador SPEI"
SPEI_SUPERADMIN_CORREO=<definir>
# Mínimo 10 caracteres con letras y números.
SPEI_SUPERADMIN_CONTRASENA=<definir>
# Contraseña de los usuarios de demostración (DemoSeeder, solo APP_ENV=local).
SPEI_DEMO_CONTRASENA=<definir>

VITE_APP_NAME="${APP_NAME}"
